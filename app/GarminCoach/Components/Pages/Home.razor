@page "/"
@inject CoachViewModel Coach
@inject AppRuntimeInfo Runtime

<h1>Garmin Coach</h1>
<p class="text-muted">A read-only cycling session from your own Garmin data.</p>
@if (!Coach.Settings.HasGarminKey) { <div class="alert alert-warning">Add your Garmin key in <a href="settings">Settings</a>.</div> }
<div class="d-flex flex-wrap gap-2 mb-3">
    <button class="btn btn-primary" disabled="@_busy" @onclick="RunAsync">What should I ride today?</button>
    <button class="btn btn-outline-secondary" disabled="@_busy" @onclick="ConnectAsync">Test connection</button>
</div>
@if (_busy) { <div class="alert alert-info">Reading your last 7 days from Garmin…</div> }
@if (Coach.TestResult is not null) { <div class="alert alert-secondary">@Coach.TestResult</div> }
@if (Coach.Error is not null) { <div class="alert alert-danger">@Coach.Error</div> }
@if (Coach.Recommendation is { } s)
{
    <div class="card mb-3"><div class="card-body">
        <h3>@s.WorkoutType · @s.DurationText</h3>
        <p class="text-muted">Intensity: @s.IntensityZone</p>
        <ol>@foreach (var st in s.Structure) { <li>@st.Description</li> }</ol>
        <p>@s.Reasoning</p>
        @if (s.MissingSignals.Count > 0) { <p class="text-warning">Missing: @string.Join(", ", s.MissingSignals)</p> }
    </div></div>
}
@if (Coach.Signals.Chips.Count > 0)
{
    <h3>Your last 7 days</h3>
    <div class="d-flex flex-wrap gap-2">
        @foreach (var c in Coach.Signals.Chips) { <div class="border rounded p-2"><div class="fw-bold">@c.Label</div><div>@c.Value</div><div class="text-muted">@c.Trend</div></div> }
    </div>
}
@code {
    private bool _busy;
    private async Task RunAsync() { _busy = true; try { await Runtime.Server.StartAsync(); await Coach.RunAsync(); } finally { _busy = false; } }
    private async Task ConnectAsync() { _busy = true; try { await Runtime.Server.StartAsync(); await Coach.TestConnectionAsync(); } finally { _busy = false; } }
}